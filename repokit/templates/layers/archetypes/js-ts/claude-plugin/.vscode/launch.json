{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hook: session-start.mjs (type the event JSON, then Ctrl+Z Enter / Ctrl+D)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/plugin/hooks/scripts/session-start.mjs",
      "cwd": "${workspaceFolder}",
      "env": { "__RK_MACRO___DEBUG": "1" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "npm test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "node: current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
